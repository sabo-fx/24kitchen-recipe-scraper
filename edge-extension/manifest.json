{
  "manifest_version": 3,
  "name": "24Kitchen Recipe to PDF",
  "version": "1.0.0",
   "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "description": "Adds a 'Download als PDF' button to 24kitchen.nl recipe pages and renders a printable A4 layout.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.24kitchen.nl/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.24kitchen.nl/recepten/*"],
      "js": ["extract.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["print/print.html", "print/print.css", "print/print.js"],
      "matches": ["https://www.24kitchen.nl/*"]
    }
  ],
  "action": {
    "default_title": "24Kitchen Recipe to PDF"
  }
}
